# Copie para .env na raiz para Docker Compose. Nunca versione o arquivo preenchido.
# Gere uma senha local forte antes de executar Compose. Não reutilize em produção.
POSTGRES_PASSWORD=
APP_ENV=development
FRONTEND_URL=http://127.0.0.1:3000
COOKIE_SECURE=false
SESSION_HOURS=168
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=PostPilot <contato@postpilot.local>
# Execução Python sem Docker: copie também este arquivo para backend/.env.
DATABASE_URL=sqlite:///./postpilot.db
# Fases futuras (sem uso nesta fase): META_APP_ID, META_APP_SECRET,
# META_REDIRECT_URI, ENCRYPTION_KEY, MERCADOPAGO_ACCESS_TOKEN,
# MERCADOPAGO_WEBHOOK_SECRET, REDIS_URL e credenciais S3.
